{
  "name": "ofir-jobs-finder",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "db:init": "python -m collector.cli init",
    "scan": "python -m collector.cli scan",
    "digest": "python -m collector.cli digest",
    "test": "python -m unittest discover -s tests -v && node --test tests/*.test.mjs",
    "test:postgres": "node --test tests/postgres.test.mjs",
    "scan:cloud": "python -m collector.cloud scan",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.0.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  }
}
