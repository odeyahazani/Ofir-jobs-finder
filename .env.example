# Local use only: binds to loopback. Never enable this on a public deployment.
LOCAL_DEV_MODE=1
# Optional absolute path shared by Next and the Python collector.
# OFIR_DB_PATH=/absolute/path/to/.local/ofir.sqlite
# For Google authentication, disable LOCAL_DEV_MODE and configure these:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
OFIR_ALLOWED_EMAIL=
APP_URL=http://127.0.0.1:3000
# For the daily digest. Set securely; never commit actual values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
